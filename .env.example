# Which Multica server to use.
#   multica.ai:              MULTICA_API_URL=https://api.multica.ai              MULTICA_APP_URL=https://multica.ai
#   multica.playdev.online:  MULTICA_API_URL=https://api.multica.playdev.online  MULTICA_APP_URL=https://multica.playdev.online
MULTICA_API_URL=https://api.multica.ai
MULTICA_APP_URL=https://multica.ai

# How to sign in. Leave empty to use the Multica Desktop login on this computer (for the server above).
# Or paste a personal access token (starts with mul_; Multica web app -> Settings -> Tokens). Keep it secret.
MULTICA_TOKEN=

# Optional. Workspace to open first; empty = the first one.
MULTICA_WORKSPACE_ID=

# Time zone for "today", due dates and late tasks.
KANTOR_TIMEZONE=Asia/Jakarta

# Name of the agent behind the floating "Ask ..." chat (must match an agent in your workspace). Empty = Mika.
NEXT_PUBLIC_KANTOR_MANAGER=

# Optional Telegram reminders (see setup/SETUP-TELEGRAM.md).
TELEGRAM_BOT_TOKEN=
# Recipients as "Name:chatId", comma-separated (Name = their name in Multica), e.g. Ara:123456,Dan:789012
TELEGRAM_CHATS=
# One bot per office: office-slug=token, separated by semicolons. Offices not listed use TELEGRAM_BOT_TOKEN.
TELEGRAM_BOTS=
