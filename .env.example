# Token akses pribadi Multica (diawali mul_). Buat di web Multica: Settings -> tokens.
# Kosongkan saat menjalankan lokal di laptop Sarah: aplikasi memakai login Multica Desktop.
MULTICA_TOKEN=
# Opsional. Kalau kosong, dipakai workspace pertama.
MULTICA_WORKSPACE_ID=
MULTICA_API_URL=https://api.multica.ai
MULTICA_APP_URL=https://multica.ai
# Zona waktu untuk menghitung "hari ini" dan overdue
KANTOR_TIMEZONE=Asia/Jakarta
